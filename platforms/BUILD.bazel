package(default_visibility = ["//visibility:public"])

platform(
    name = "local_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "rpi5_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

# Config setting for rpi5_aarch64 platform
config_setting(
    name = "rpi5_aarch64_config",
    values = {"--platforms": "//platforms:rpi5_aarch64"},
)
